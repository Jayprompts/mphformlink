generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  endpoints     Endpoint[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Endpoint {
  id                  String    @id @default(cuid())
  key                 String    @unique @default(cuid())
  name                String
  ownerId             String

  destinationEmail    String
  destinationVerified Boolean   @default(false)
  destinationVerifiedAt DateTime?

  isActive            Boolean   @default(false)

  allowedOrigins      String[]  @default([])
  requireTurnstile    Boolean   @default(false)
  honeypotField       String    @default("_gotcha")

  rateLimitPerMinute  Int       @default(5)
  rateLimitPerDay     Int       @default(100)

  redirectUrlDefault  String?
  autoResponseSubject String?

  createdAt           DateTime  @default(now())
  updatedAt            DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([ownerId])
  @@map("endpoints")
}

model Submission {
  id          String   @id @default(cuid())
  endpointId  String

  data        Json
  senderIp    String?
  userAgent   String?
  referer     String?

  isSpam      Boolean  @default(false)
  spamReason  String?

  emailSent   Boolean  @default(false)
  emailError  String?

  createdAt   DateTime @default(now())

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("submissions")
}

model RateLimitHit {
  id          String   @id @default(cuid())
  bucketKey   String
  windowType  String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucketKey, windowType, windowStart])
  @@map("rate_limit_hits")
}